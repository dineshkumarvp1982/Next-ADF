{
	"name": "SelfServeFromFile",
	"properties": {
		"activities": [
			{
				"name": "CopyToDataLake",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": true
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false,
					"validateDataConsistency": false
				},
				"inputs": [
					{
						"referenceName": "FileSystemBinaryDataset",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": {
								"value": "@pipeline().parameters.SourceFolderName",
								"type": "Expression"
							},
							"FileName": {
								"value": "@pipeline().parameters.SourceFileName",
								"type": "Expression"
							},
							"WindowsAuthUserName": "Next-PLC\\Admin-BIS-DBA",
							"WindowsAuthPasswordInKeyVault": "AdminBISDBA"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "SelfServeDataLakeBinaryDataset",
						"type": "DatasetReference",
						"parameters": {
							"DataLakeName": {
								"value": "@pipeline().parameters.DestinationDataLakeName",
								"type": "Expression"
							},
							"FolderName": {
								"value": "@pipeline().parameters.DestinationFolderName",
								"type": "Expression"
							},
							"FileName": {
								"value": "@pipeline().parameters.DestinationFileName",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"SourceFolderName": {
				"type": "string"
			},
			"SourceFileName": {
				"type": "string"
			},
			"DestinationDataLakeName": {
				"type": "string"
			},
			"DestinationFolderName": {
				"type": "string"
			},
			"DestinationFileName": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Self Serve"
		},
		"annotations": []
	}
}