{
	"name": "CopyFilesToLandingPipeline",
	"properties": {
		"activities": [
			{
				"name": "WriteTaskStarted",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:15:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[Status].[WriteCopyFileToLandingStarted]",
						"storedProcedureParameters": {
							"CopyFileToLandingID": {
								"type": "Int32",
								"value": {
									"value": "@pipeline().parameters.Id",
									"type": "Expression"
								}
							},
							"PipelineId": {
								"type": "Guid",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							"PipelineRun": {
								"type": "DateTimeOffset",
								"value": {
									"value": "@utcnow()",
									"type": "Expression"
								}
							}
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ETLManagementDataset",
						"type": "DatasetReference",
						"parameters": {
							"TableName": " "
						}
					}
				}
			},
			{
				"name": "CopyToLanding",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check if Date Mask Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.03:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": false,
							"wildcardFileName": {
								"value": "@variables('FileNameMask')",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": {
								"value": "@activity('WriteTaskStarted').output.firstRow.DeleteOnCompletion",
								"type": "Expression"
							}
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "FileSystemBinaryDataset",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": {
								"value": "@activity('WriteTaskStarted').output.firstRow.FileSystemFolder",
								"type": "Expression"
							},
							"FileName": {
								"value": "NULL",
								"type": "Expression"
							},
							"WindowsAuthUserName": {
								"value": "@activity('WriteTaskStarted').output.firstRow.Username",
								"type": "Expression"
							},
							"WindowsAuthPasswordInKeyVault": {
								"value": "@activity('WriteTaskStarted').output.firstRow.PasswordInKeyVault",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "LandingBinarySink",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.DestinationFolder}",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "WriteTaskEnded",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "CheckKeepOnlyOne",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:15:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[Status].[WriteCopyFileToLandingEnded]",
					"storedProcedureParameters": {
						"FileLocation": {
							"value": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.DestinationFolder}",
								"type": "Expression"
							},
							"type": "String"
						},
						"FilesWritten": {
							"value": {
								"value": "@activity('CopyToLanding').output.filesWritten",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"PipelineRun": {
							"value": {
								"value": "@utcnow()",
								"type": "Expression"
							},
							"type": "DateTimeOffset"
						},
						"SourceHistoryId": {
							"value": {
								"value": "@activity('WriteTaskStarted').output.firstRow.SourceHistoryID",
								"type": "Expression"
							},
							"type": "Int64"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ETLManagementLinkedService",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "CheckFilesWritten",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "CopyToLanding",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('CopyToLanding').output.filesWritten,0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Raise error",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:15:00",
								"retry": 1,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[Status].[CreateADFError]",
								"storedProcedureParameters": {
									"ErrorMessage": {
										"value": "No File was copied",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ETLManagementLinkedService",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Check if Date Mask Exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set FileNameMask",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(indexOf(activity('WriteTaskStarted').output.firstRow.FileNameMask,'}'),0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Set MaskStart",
							"type": "SetVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "MaskStart",
								"value": {
									"value": "@string(indexOf(variables('FileNameMask'),'{'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set MaskEnd",
							"type": "SetVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "MaskEnd",
								"value": {
									"value": "@string(indexOf(variables('FileNameMask'),'}'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set MaskSectionLength",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set MaskStart",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "Set MaskEnd",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "MaskSectionLength",
								"value": {
									"value": "@string(add(1,sub(int(variables('MaskEnd')),int(variables('MaskStart')))))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set MaskSection",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set MaskSectionLength",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "MaskSection",
								"value": {
									"value": "@substring(variables('FileNameMask'),int(variables('MaskStart')),int(variables('MaskSectionLength')))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set DateMask",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set MaskSection",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "DateMask",
								"value": {
									"value": "@replace(replace(variables('MaskSection'),'{' ,'' ),'}','')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set DateString",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set DateMask",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "DateString",
								"value": {
									"value": "@addDays(convertFromUtc(utcNow(),'GMT Standard Time'),activity('WriteTaskStarted').output.firstRow.DayOffsetForFileMask,variables('DateMask'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set FileNameMaskWithDate",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set DateString",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "FileNameMaskWithDate",
								"value": {
									"value": "@replace(variables('FileNameMask'),variables('MaskSection') ,variables('DateString') )",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set FileNameMask on subactivity",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Set FileNameMaskWithDate",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "FileNameMask",
								"value": {
									"value": "@variables('FileNameMaskWithDate')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Set FileNameMask",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "WriteTaskStarted",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "FileNameMask",
					"value": {
						"value": "@activity('WriteTaskStarted').output.firstRow.FileNameMask",
						"type": "Expression"
					}
				}
			},
			{
				"name": "CheckKeepOnlyOne",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "CopyToLanding",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('WriteTaskStarted').output.firstRow.KeepOldestOrNewest",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "KeepOldestOrNewestFile Notebook",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.03:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Shared/bisparkADF/release/notebooks/KeepOldestOrNewestFile",
								"baseParameters": {
									"PathToFolder": {
										"value": "@activity('WriteTaskStarted').output.firstRow.PathToFolder",
										"type": "Expression"
									},
									"FileName": {
										"value": "@activity('WriteTaskStarted').output.firstRow.FileName",
										"type": "Expression"
									},
									"NameOrModified": {
										"value": "@activity('WriteTaskStarted').output.firstRow.NameOrModified",
										"type": "Expression"
									},
									"OldestOrNewest": {
										"value": "@activity('WriteTaskStarted').output.firstRow.OldestOrNewest",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "DatabricksLinkedService",
								"type": "LinkedServiceReference",
								"parameters": {
									"MinWorkers": 1,
									"MaxWorkers": 4
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"Id": {
				"type": "int"
			}
		},
		"variables": {
			"FileNameMask": {
				"type": "String"
			},
			"DateMask": {
				"type": "String"
			},
			"DateString": {
				"type": "String"
			},
			"MaskSection": {
				"type": "String"
			},
			"MaskStart": {
				"type": "String"
			},
			"MaskEnd": {
				"type": "String"
			},
			"MaskSectionLength": {
				"type": "String"
			},
			"FileNameMaskWithDate": {
				"type": "String"
			}
		},
		"annotations": []
	}
}