								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"url": {
									"value": "@pipeline().parameters.LogicAppUrl",
									"type": "Expression"
								},
								"method": "POST",
								"body": {
									"value": "{\n  \"smsfrom\": \"@{variables('smsfrom')}\",\n  \"smsto\": \"@{variables('smsto')}\",\n  \"smsmessage\": \"@{variables('smsmessage')}\",\n  \"emailfrom\": \"@{variables('emailfrom')}\",\n  \"emailto\": \"@{variables('emailto')}\",\n  \"emailsub\": \"@{variables('emailsub')}\",\n  \"emailtext\": \"@{variables('emailtext')}\"\n}",
									"type": "Expression"
								}
