					"source": {
						"type": "SqlMISource",
						"sqlReaderQuery": "--Declaring Variables\n\nDECLARE @PhoneNo    AS NVARCHAR(50)\nDECLARE @var_AB_Failure_EmailTo      AS NVARCHAR(1000)\nDECLARE @var_AB_Failure_DefaultEmailTo AS NVARCHAR(1000)\nDECLARE @var_AB_Failure_DefaultPhone   AS NVARCHAR(50)\nDECLARE @var_AB_Failure_UseDefaultYN   AS NVARCHAR(1)\n\n--Setting Up Variables\n SET @var_AB_Failure_EmailTo = (SELECT ConfiguredValue FROM ETL_Management.dbo.DWParameters WHERE ConfigurationFilter = 'var_AB_Failure_EmailTo')\n SET @var_AB_Failure_DefaultEmailTo = (SELECT ConfiguredValue FROM ETL_Management.dbo.DWParameters WHERE ConfigurationFilter = 'var_AB_Failure_DefaultEmailTo')\n SET @var_AB_Failure_DefaultPhone     = (SELECT ConfiguredValue FROM ETL_Management.dbo.DWParameters WHERE ConfigurationFilter = 'var_AB_Failure_DefaultPhone')\n SET @var_AB_Failure_UseDefaultYN = (SELECT ConfiguredValue FROM ETL_Management.dbo.DWParameters WHERE ConfigurationFilter = 'var_AB_Failure_UseDefaultYN')\n SET @PhoneNo = (SELECT TOP 1 Contact_SupportA.PhoneNumber\n                 FROM ETL_Management.callout.CalloutTimetable TimeTable\n                 INNER JOIN ETL_Management.callout.CalloutContacts Contact_SupportA ON TimeTable.SupportA_ID = Contact_SupportA.SupportID\n                 WHERE ActiveIndicator = 1)\n\n  IF @var_AB_Failure_UseDefaultYN = 'Y'\n  BEGIN\n     SET @PhoneNo = @var_AB_Failure_DefaultPhone\n\t SET @var_AB_Failure_EmailTo = @var_AB_Failure_DefaultEmailTo\n  END\n\n  select @PhoneNo as contactphone,@var_AB_Failure_EmailTo as contactemail",
