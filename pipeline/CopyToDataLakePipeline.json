{
	"name": "CopyToDataLakePipeline",
	"properties": {
		"activities": [
			{
				"name": "WriteTaskStarted",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[Status].[WriteCopyToDataLakeStarted]",
						"storedProcedureParameters": {
							"PipelineId": {
								"type": "Guid",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							"PipelineRun": {
								"type": "DateTimeOffset",
								"value": {
									"value": "@utcnow()",
									"type": "Expression"
								}
							},
							"CopyToDataLakeSourceId": {
								"type": "Int32",
								"value": {
									"value": "@pipeline().parameters.Id",
									"type": "Expression"
								}
							}
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ETLManagementDataset",
						"type": "DatasetReference",
						"parameters": {
							"TableName": " "
						}
					}
				}
			},
			{
				"name": "CopyToCurrent",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "varFileExtension",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "FileServerReadSettings",
							"recursive": false,
							"wildcardFileName": {
								"value": "@{variables('varFileSystemFileName')}.@{variables('varFileExtension')}",
								"type": "Expression"
							},
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "AzureBlobFSSink"
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "FileSystemBinaryDataset",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": {
								"value": "@activity('WriteTaskStarted').output.firstRow.FileSystemFolderName",
								"type": "Expression"
							},
							"FileName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FileSystemFileName}.@{activity('WriteTaskStarted').output.firstRow.Extension}",
								"type": "Expression"
							},
							"WindowsAuthUserName": {
								"value": "@activity('WriteTaskStarted').output.firstRow.Username",
								"type": "Expression"
							},
							"WindowsAuthPasswordInKeyVault": {
								"value": "@activity('WriteTaskStarted').output.firstRow.PasswordInKeyVault",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DataLakeBinaryDataset",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FolderName}/current",
								"type": "Expression"
							},
							"FileName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FileName}.@{activity('WriteTaskStarted').output.firstRow.Extension}",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "WriteTaskEnded",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "CopyToPartition",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[Status].[WriteEnded]",
					"storedProcedureParameters": {
						"SourceHistoryId": {
							"value": {
								"value": "@activity('WriteTaskStarted').output.firstRow.SourceHistoryId",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"PipelineRun": {
							"value": {
								"value": "@utcnow()",
								"type": "Expression"
							},
							"type": "DateTimeOffset"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ETLManagementLinkedService",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "CopyToPartition",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "CopyToCurrent",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureBlobFSSource",
						"recursive": true
					},
					"sink": {
						"type": "AzureBlobFSSink"
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DataLakeBinaryDataset",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FolderName}/current",
								"type": "Expression"
							},
							"FileName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FileName}.@{activity('WriteTaskStarted').output.firstRow.Extension}",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DataLakeBinaryDataset",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FolderName}/@{activity('WriteTaskStarted').output.firstRow.PartitionName}",
								"type": "Expression"
							},
							"FileName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FileName}.@{activity('WriteTaskStarted').output.firstRow.Extension}",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "varFileSystemFileName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "WriteTaskStarted",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "varFileSystemFileName",
					"value": {
						"value": "@{activity('WriteTaskStarted').output.firstRow.FileSystemFileName}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "varFileExtension",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "varFileSystemFileName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"variableName": "varFileExtension",
					"value": {
						"value": "@{activity('WriteTaskStarted').output.firstRow.Extension}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"Id": {
				"type": "int"
			}
		},
		"variables": {
			"varFileSystemFileName": {
				"type": "String"
			},
			"varFileExtension": {
				"type": "String"
			}
		},
		"annotations": []
	}
}