{
	"name": "CopyToSqlPipeline",
	"properties": {
		"activities": [
			{
				"name": "WriteTaskEnded",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "CopyToSql",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[Status].[WriteCopyToSqlEnded]",
					"storedProcedureParameters": {
						"SourceHistoryId": {
							"value": {
								"value": "@activity('WriteTaskStarted').output.firstRow.SourceHistoryId",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"PipelineRun": {
							"value": {
								"value": "@utcnow()",
								"type": "Expression"
							},
							"type": "DateTimeOffset"
						},
						"RowsCopiedToSql": {
							"value": {
								"value": "@activity('CopyToSql').output.rowsCopied",
								"type": "Expression"
							},
							"type": "Int32"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ETLManagementLinkedService",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "WriteTaskStarted",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[Status].[WriteCopyToSqlStarted]",
						"storedProcedureParameters": {
							"PipelineId": {
								"type": "Guid",
								"value": {
									"value": "@pipeline().RunId",
									"type": "Expression"
								}
							},
							"PipelineRun": {
								"type": "DateTimeOffset",
								"value": {
									"value": "@utcnow()",
									"type": "Expression"
								}
							},
							"CopyToSqlSourceId": {
								"type": "Int32",
								"value": {
									"value": "@pipeline().parameters.Id",
									"type": "Expression"
								}
							}
						},
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "ETLManagementDataset",
						"type": "DatasetReference",
						"parameters": {
							"TableName": " "
						}
					}
				}
			},
			{
				"name": "CopyToSql",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "WriteTaskStarted",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFileName": "*.parquet",
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "SqlMISink",
						"preCopyScript": {
							"value": "TRUNCATE TABLE @{activity('WriteTaskStarted').output.firstRow.TableName}",
							"type": "Expression"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DataLakeParquetDataset",
						"type": "DatasetReference",
						"parameters": {
							"FolderName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FolderName}/current",
								"type": "Expression"
							},
							"FileName": {
								"value": "@{activity('WriteTaskStarted').output.firstRow.FileName}.parquet",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AzureSqlManagedInstanceDataset",
						"type": "DatasetReference",
						"parameters": {
							"ServerName": {
								"value": "@activity('WriteTaskStarted').output.firstRow.ServerName",
								"type": "Expression"
							},
							"DatabaseName": {
								"value": "@activity('WriteTaskStarted').output.firstRow.DatabaseName",
								"type": "Expression"
							},
							"TableName": {
								"value": "@activity('WriteTaskStarted').output.firstRow.TableName",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"Id": {
				"type": "int"
			}
		},
		"annotations": []
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}