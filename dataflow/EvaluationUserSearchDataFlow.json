{
	"name": "EvaluationUserSearchDataFlow",
	"properties": {
		"folder": {
			"name": "ContactCentre/Genesys"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "DataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "JsonSource",
					"description": "Import data from DataLakeLinkedService"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "GenericDataLakeParquetDataSet",
						"type": "DatasetReference"
					},
					"name": "ParquetDestination",
					"description": "Export data to GenericDataLakeParquetDataSet"
				}
			],
			"transformations": [
				{
					"name": "flattenResults"
				},
				{
					"name": "flattenAddress"
				},
				{
					"name": "flattenImage"
				},
				{
					"name": "flattenLanguage"
				},
				{
					"name": "flattenSkills"
				},
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "flattenLocation"
				},
				{
					"name": "join3"
				}
			],
			"scriptLines": [
				"parameters{",
				"     FolderName as string,",
				"     FileName as string",
				"}",
				"source(output(",
				"          entities as (acdAutoAnswer as boolean, addresses as (address as string, countryCode as string, display as string, mediaType as string, type as string)[], chat as (jabberId as string), department as string, division as (id as string, name as string, selfUri as string), email as string, groups as (id as string, selfUri as string)[], id as string, images as (imageUri as string, resolution as string)[], languages as (id as string, languageUri as string, name as string, proficiency as double, selfUri as string, state as string)[], locations as (locationDefinition as (id as string, selfUri as string), notes as string)[], manager as (id as string, selfUri as string), name as string, primaryContactInfo as (address as string, display as string, mediaType as string, type as string)[], selfUri as string, skills as (id as string, name as string, proficiency as double, selfUri as string, skillUri as string, state as string)[], state as string, title as string, username as string, version as short)[],",
				"          firstUri as string,",
				"          lastUri as string,",
				"          nextUri as string,",
				"          pageCount as short,",
				"          pageNumber as short,",
				"          pageSize as short,",
				"          previousUri as string,",
				"          selfUri as string,",
				"          total as short",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'json',",
				"     fileSystem: 'raw',",
				"     documentForm: 'documentPerLine',",
				"     backslashEscape: true,",
				"     wildcardPaths:[(concat($FolderName,concat($FileName,'*.json'))\r",
				")]) ~> JsonSource",
				"JsonSource foldDown(unroll(entities),",
				"     mapColumn(",
				"          acdAutoAnswer = entities.acdAutoAnswer,",
				"          addresses = entities.addresses,",
				"          jabberId = entities.chat,",
				"          department = entities.department,",
				"          division = entities.division,",
				"          email = entities.email,",
				"          groups = entities.groups,",
				"          mainId = entities.id,",
				"          images = entities.images,",
				"          languages = entities.languages,",
				"          locations = entities.locations,",
				"          manager = entities.manager,",
				"          name = entities.name,",
				"          primaryContactInfo = entities.primaryContactInfo,",
				"          selfUri = entities.selfUri,",
				"          skills = entities.skills,",
				"          state = entities.state,",
				"          title = entities.title,",
				"          username = entities.username,",
				"          version = entities.version",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenResults",
				"flattenResults foldDown(unroll(addresses),",
				"     mapColumn(",
				"          address = addresses.address,",
				"          mainId,",
				"          countryCode = addresses.countryCode,",
				"          display = addresses.display,",
				"          addressMediaType = addresses.mediaType,",
				"          addressType = addresses.type",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenAddress",
				"flattenResults foldDown(unroll(images),",
				"     mapColumn(",
				"          imageUri = images.imageUri,",
				"          mainId,",
				"          resolution = images.resolution",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenImage",
				"flattenResults foldDown(unroll(languages),",
				"     mapColumn(",
				"          department,",
				"          title,",
				"          email,",
				"          name,",
				"          mainId,",
				"          languageId = languages.id,",
				"          languageUri = languages.languageUri,",
				"          languageName = languages.name,",
				"          languageProficiency = languages.proficiency,",
				"          languageSelfUri = languages.selfUri,",
				"          languageState = languages.state,",
				"          jabberId = jabberId.jabberId,",
				"          divisionId = division.id,",
				"          divisionName = division.name,",
				"          divisionselfUri = division.selfUri,",
				"          managerId = manager.id",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenLanguage",
				"flattenResults foldDown(unroll(skills),",
				"     mapColumn(",
				"          skillsId = skills.id,",
				"          mainId,",
				"          skillsName = skills.name,",
				"          proficiency = skills.proficiency,",
				"          skillsselfUri = skills.selfUri,",
				"          skillUri = skills.skillUri,",
				"          skillsState = skills.state",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenSkills",
				"flattenLanguage, flattenAddress join(flattenLanguage@mainId == flattenAddress@mainId,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, flattenSkills join(flattenLanguage@mainId == flattenSkills@mainId,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"flattenResults foldDown(unroll(locations, locations),",
				"     mapColumn(",
				"          locationId = locations.locationDefinition.id,",
				"          mainId,",
				"          locationNotes = locations.notes",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenLocation",
				"join2, flattenLocation join(flattenLanguage@mainId == flattenLocation@mainId,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat($FileName,'.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          department,",
				"          title,",
				"          email,",
				"          name,",
				"          languageId,",
				"          languageUri,",
				"          languageName,",
				"          languageProficiency,",
				"          languageSelfUri,",
				"          languageState,",
				"          jabberId,",
				"          divisionId,",
				"          divisionName,",
				"          divisionselfUri,",
				"          managerId,",
				"          address,",
				"          countryCode,",
				"          display,",
				"          addressMediaType,",
				"          addressType,",
				"          skillsId,",
				"          skillsName,",
				"          proficiency,",
				"          skillsselfUri,",
				"          skillUri,",
				"          skillsState,",
				"          locationId,",
				"          locationNotes",
				"     ),",
				"     partitionBy('hash', 1)) ~> ParquetDestination"
			]
		}
	}
}