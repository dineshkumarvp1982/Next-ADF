{
	"name": "EvaluationPublishedFormsDataFlow",
	"properties": {
		"folder": {
			"name": "ContactCentre/Genesys"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "DataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "JsonSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "GenericDataLakeParquetDataSet",
						"type": "DatasetReference"
					},
					"name": "ParquetDestination"
				}
			],
			"transformations": [
				{
					"name": "sort1"
				},
				{
					"name": "flatten2"
				},
				{
					"name": "flatten1"
				},
				{
					"name": "flatten3"
				}
			],
			"scriptLines": [
				"parameters{",
				"     FolderName as string,",
				"     FileName as string",
				"}",
				"source(output(",
				"          contextId as string,",
				"          id as string,",
				"          modifiedDate as string,",
				"          name as string,",
				"          published as boolean,",
				"          questionGroups as (defaultAnswersToHighest as boolean, defaultAnswersToNA as boolean, id as string, manualWeight as boolean, naEnabled as boolean, name as string, questions as (answerOptions as (id as string, text as string, value as integer)[], commentsRequired as boolean, helpText as string, id as string, isCritical as boolean, isKill as boolean, naEnabled as boolean, text as string, type as string)[], type as string, weight as double)[],",
				"          selfUri as string,",
				"          weightMode as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'json',",
				"     fileSystem: 'raw',",
				"     documentForm: 'documentPerLine',",
				"     backslashEscape: true,",
				"     wildcardPaths:[(concat($FolderName,concat($FileName,'*.json')))]) ~> JsonSource",
				"flatten3 sort(asc(evaluations_id, false),",
				"     asc(evaluations_name, false),",
				"     asc(modifiedDate, false),",
				"     asc(published, false)) ~> sort1",
				"flatten1 foldDown(unroll(questions, questions),",
				"     mapColumn(",
				"          evaluations_id,",
				"          evaluations_name,",
				"          modifiedDate,",
				"          published,",
				"          contextId,",
				"          id = questionGroups_id,",
				"          name = questionGroups_name,",
				"          type = questionGroups_type,",
				"          defaultAnswersToHighest,",
				"          defaultAnswersToNA,",
				"          naEnabled,",
				"          weight,",
				"          manualWeight,",
				"          questions_id = questions.id,",
				"          text = questions.text,",
				"          helpText = questions.helpText,",
				"          {_type} = questions.type,",
				"          {_naEnabled} = questions.naEnabled,",
				"          commentsRequired = questions.commentsRequired,",
				"          answerOptions = questions.answerOptions",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten2",
				"JsonSource foldDown(unroll(questionGroups, questionGroups),",
				"     mapColumn(",
				"          evaluations_id = id,",
				"          evaluations_name = name,",
				"          modifiedDate,",
				"          published,",
				"          contextId,",
				"          questionGroups_id = questionGroups.id,",
				"          questionGroups_name = questionGroups.name,",
				"          questionGroups_type = questionGroups.type,",
				"          defaultAnswersToHighest = questionGroups.defaultAnswersToHighest,",
				"          defaultAnswersToNA = questionGroups.defaultAnswersToNA,",
				"          naEnabled = questionGroups.naEnabled,",
				"          weight = questionGroups.weight,",
				"          manualWeight = questionGroups.manualWeight,",
				"          questions = questionGroups.questions",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"flatten2 foldDown(unroll(answerOptions, answerOptions),",
				"     mapColumn(",
				"          evaluations_id,",
				"          evaluations_name,",
				"          modifiedDate,",
				"          published,",
				"          contextId,",
				"          id,",
				"          name,",
				"          type,",
				"          defaultAnswersToHighest,",
				"          defaultAnswersToNA,",
				"          naEnabled,",
				"          weight,",
				"          manualWeight,",
				"          questions_id,",
				"          text,",
				"          helpText,",
				"          {_type},",
				"          {_naEnabled},",
				"          commentsRequired,",
				"          answerOptions_id = answerOptions.id,",
				"          answerOptions_text = answerOptions.text,",
				"          value = answerOptions.value",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten3",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat($FileName,'.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          evaluations_id,",
				"          evaluations_name,",
				"          modifiedDate,",
				"          published,",
				"          contextId,",
				"          id,",
				"          name,",
				"          type,",
				"          defaultAnswersToHighest,",
				"          defaultAnswersToNA,",
				"          naEnabled,",
				"          weight,",
				"          manualWeight,",
				"          questions_id,",
				"          text,",
				"          helpText,",
				"          {_type},",
				"          {_naEnabled},",
				"          commentsRequired,",
				"          answerOptions_id,",
				"          answerOptions_text,",
				"          value",
				"     ),",
				"     partitionBy('hash', 1)) ~> ParquetDestination"
			]
		}
	}
}