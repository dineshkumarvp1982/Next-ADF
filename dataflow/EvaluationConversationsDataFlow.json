{
	"name": "EvaluationConversationsDataFlow",
	"properties": {
		"folder": {
			"name": "ContactCentre/Genesys"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "DataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "JsonSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "GenericDataLakeParquetDataSet",
						"type": "DatasetReference"
					},
					"name": "ParquetDestination"
				}
			],
			"transformations": [
				{
					"name": "flatten2"
				},
				{
					"name": "sort1"
				},
				{
					"name": "flatten1"
				},
				{
					"name": "flatten3"
				}
			],
			"scriptLines": [
				"parameters{",
				"     FolderName as string,",
				"     FileName as string",
				"}",
				"source(output(",
				"          agent as (id as string, selfUri as string),",
				"          agentHasRead as boolean,",
				"          answers as (anyFailedKillQuestions as boolean, comments as string, questionGroupScores as (markedNA as boolean, maxTotalCriticalScore as double, maxTotalCriticalScoreUnweighted as double, maxTotalNonCriticalScore as double, maxTotalNonCriticalScoreUnweighted as double, maxTotalScore as double, maxTotalScoreUnweighted as double, questionGroupId as string, questionScores as (answerId as string, comments as string, failedKillQuestion as boolean, markedNA as boolean, questionId as string, score as integer)[], totalCriticalScore as double, totalCriticalScoreUnweighted as double, totalNonCriticalScore as double, totalNonCriticalScoreUnweighted as double, totalScore as double, totalScoreUnweighted as double)[], totalCriticalScore as double, totalNonCriticalScore as double, totalScore as double),",
				"          assignedDate as string,",
				"          authorizedActions as string[],",
				"          changedDate as string,",
				"          conversation as (id as string, selfUri as string),",
				"          conversationDate as string,",
				"          conversationEndDate as string,",
				"          evaluationForm as (id as string, name as string, published as boolean, selfUri as string),",
				"          evaluator as (id as string, selfUri as string),",
				"          id as string,",
				"          mediaType as string[],",
				"          neverRelease as boolean,",
				"          queue as (autoAnswerOnly as boolean, id as string, selfUri as string),",
				"          releaseDate as string,",
				"          rescore as boolean,",
				"          selfUri as string,",
				"          status as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'json',",
				"     fileSystem: 'raw',",
				"     documentForm: 'documentPerLine',",
				"     backslashEscape: true,",
				"     wildcardPaths:[(concat($FolderName,concat($FileName,'*.json')))]) ~> JsonSource",
				"flatten1 foldDown(unroll(questionScores, questionScores),",
				"     mapColumn(",
				"          conversation_id,",
				"          evaluationForm_id,",
				"          name,",
				"          selfUri,",
				"          evaluator_id,",
				"          agent_id,",
				"          status,",
				"          answers_totalScore,",
				"          answers_totalCriticalScore,",
				"          answers_totalNonCriticalScore,",
				"          questionGroupId,",
				"          totalScore,",
				"          maxTotalScore,",
				"          markedNA,",
				"          totalCriticalScore,",
				"          maxTotalCriticalScore,",
				"          totalNonCriticalScore,",
				"          maxTotalNonCriticalScore,",
				"          totalScoreUnweighted,",
				"          maxTotalScoreUnweighted,",
				"          totalCriticalScoreUnweighted,",
				"          maxTotalCriticalScoreUnweighted,",
				"          totalNonCriticalScoreUnweighted,",
				"          maxTotalNonCriticalScoreUnweighted,",
				"          questionId = questionScores.questionId,",
				"          answerId = questionScores.answerId,",
				"          score = questionScores.score,",
				"          {_markedNA} = questionScores.markedNA,",
				"          comments = questionScores.comments,",
				"          agentHasRead,",
				"          releaseDate,",
				"          assignedDate,",
				"          changedDate,",
				"          queue_id,",
				"          conversationDate,",
				"          conversationEndDate,",
				"          mediaType",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten2",
				"flatten3 sort(asc(conversation_id, false),",
				"     asc(evaluationForm_id, false),",
				"     asc(name, false),",
				"     asc(selfUri, false),",
				"     asc(evaluator_id, false),",
				"     asc(agent_id, false),",
				"     asc(status, false),",
				"     asc(conversationDate, false),",
				"     asc(conversationEndDate, false)) ~> sort1",
				"JsonSource foldDown(unroll(answers.questionGroupScores, answers.questionGroupScores),",
				"     mapColumn(",
				"          conversation_id = conversation.id,",
				"          evaluationForm_id = evaluationForm.id,",
				"          name = evaluationForm.name,",
				"          selfUri = evaluationForm.selfUri,",
				"          evaluator_id = evaluator.id,",
				"          agent_id = agent.id,",
				"          status,",
				"          answers_totalScore = answers.totalScore,",
				"          answers_totalCriticalScore = answers.totalCriticalScore,",
				"          answers_totalNonCriticalScore = answers.totalNonCriticalScore,",
				"          questionGroupId = answers.questionGroupScores.questionGroupId,",
				"          totalScore = answers.questionGroupScores.totalScore,",
				"          maxTotalScore = answers.questionGroupScores.maxTotalScore,",
				"          markedNA = answers.questionGroupScores.markedNA,",
				"          totalCriticalScore = answers.questionGroupScores.totalCriticalScore,",
				"          maxTotalCriticalScore = answers.questionGroupScores.maxTotalCriticalScore,",
				"          totalNonCriticalScore = answers.questionGroupScores.totalNonCriticalScore,",
				"          maxTotalNonCriticalScore = answers.questionGroupScores.maxTotalNonCriticalScore,",
				"          totalScoreUnweighted = answers.questionGroupScores.totalScoreUnweighted,",
				"          maxTotalScoreUnweighted = answers.questionGroupScores.maxTotalScoreUnweighted,",
				"          totalCriticalScoreUnweighted = answers.questionGroupScores.totalCriticalScoreUnweighted,",
				"          maxTotalCriticalScoreUnweighted = answers.questionGroupScores.maxTotalCriticalScoreUnweighted,",
				"          totalNonCriticalScoreUnweighted = answers.questionGroupScores.totalNonCriticalScoreUnweighted,",
				"          maxTotalNonCriticalScoreUnweighted = answers.questionGroupScores.maxTotalNonCriticalScoreUnweighted,",
				"          questionScores = answers.questionGroupScores.questionScores,",
				"          agentHasRead,",
				"          releaseDate,",
				"          assignedDate,",
				"          changedDate,",
				"          queue_id = queue.id,",
				"          mediaType,",
				"          conversationDate,",
				"          conversationEndDate",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"flatten2 foldDown(unroll(mediaType, mediaType),",
				"     mapColumn(",
				"          conversation_id,",
				"          evaluationForm_id,",
				"          name,",
				"          selfUri,",
				"          evaluator_id,",
				"          agent_id,",
				"          status,",
				"          answers_totalScore,",
				"          answers_totalCriticalScore,",
				"          answers_totalNonCriticalScore,",
				"          questionGroupId,",
				"          totalScore,",
				"          maxTotalScore,",
				"          markedNA,",
				"          totalCriticalScore,",
				"          maxTotalCriticalScore,",
				"          totalNonCriticalScore,",
				"          maxTotalNonCriticalScore,",
				"          totalScoreUnweighted,",
				"          maxTotalScoreUnweighted,",
				"          totalCriticalScoreUnweighted,",
				"          maxTotalCriticalScoreUnweighted,",
				"          totalNonCriticalScoreUnweighted,",
				"          maxTotalNonCriticalScoreUnweighted,",
				"          questionId,",
				"          answerId,",
				"          score,",
				"          {_markedNA},",
				"          comments,",
				"          agentHasRead,",
				"          releaseDate,",
				"          assignedDate,",
				"          changedDate,",
				"          queue_id,",
				"          conversationDate,",
				"          conversationEndDate,",
				"          mediaType",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten3",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat($FileName,'.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          conversation_id,",
				"          evaluationForm_id,",
				"          name,",
				"          selfUri,",
				"          evaluator_id,",
				"          agent_id,",
				"          status,",
				"          answers_totalScore,",
				"          answers_totalCriticalScore,",
				"          answers_totalNonCriticalScore,",
				"          questionGroupId,",
				"          totalScore,",
				"          maxTotalScore,",
				"          markedNA,",
				"          totalCriticalScore,",
				"          maxTotalCriticalScore,",
				"          totalNonCriticalScore,",
				"          maxTotalNonCriticalScore,",
				"          totalScoreUnweighted,",
				"          maxTotalScoreUnweighted,",
				"          totalCriticalScoreUnweighted,",
				"          maxTotalCriticalScoreUnweighted,",
				"          totalNonCriticalScoreUnweighted,",
				"          maxTotalNonCriticalScoreUnweighted,",
				"          questionId,",
				"          answerId,",
				"          score,",
				"          {_markedNA},",
				"          comments,",
				"          agentHasRead,",
				"          releaseDate,",
				"          assignedDate,",
				"          changedDate,",
				"          queue_id,",
				"          conversationDate,",
				"          conversationEndDate,",
				"          mediaType",
				"     ),",
				"     partitionBy('hash', 1)) ~> ParquetDestination"
			]
		}
	}
}