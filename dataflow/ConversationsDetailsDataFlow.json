{
	"name": "ConversationsDetailsDataFlow",
	"properties": {
		"folder": {
			"name": "ContactCentre/Genesys"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "DataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "JsonSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "GenericDataLakeParquetDataSet",
						"type": "DatasetReference"
					},
					"name": "ParquetDestination"
				}
			],
			"transformations": [
				{
					"name": "flatten1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "flatten2"
				},
				{
					"name": "flatten3"
				},
				{
					"name": "flatten4"
				},
				{
					"name": "flatten5"
				},
				{
					"name": "flatten6"
				}
			],
			"scriptLines": [
				"parameters{",
				"     FolderName as string,",
				"     FileName as string",
				"}",
				"source(output(",
				"          conversations as (conversationEnd as string, conversationId as string, conversationStart as string, divisionIds as string[], mediaStatsMinConversationMos as double, mediaStatsMinConversationRFactor as double, originatingDirection as string, participants as (participantId as string, participantName as string, purpose as string, sessions as (activeSkillIds as string[], addressFrom as string, addressOther as string, addressSelf as string, addressTo as string, agentBullseyeRing as boolean, ani as string, direction as string, dnis as string, edgeId as string, flow as (endingLanguage as string, entryReason as string, entryType as string, exitReason as string, flowId as string, flowName as string, flowType as string, flowVersion as double, startingLanguage as string, transferTargetAddress as string, transferTargetName as string, transferType as string), flowInType as string, mediaEndpointStats as (codecs as string[], discardedPackets as integer, eventTime as string, maxLatencyMs as integer, minMos as double, minRFactor as double, receivedPackets as integer)[], mediaType as string, metrics as (emitDate as string, name as string, value as integer)[], peerId as string, protocolCallId as string, provider as string, recording as boolean, remote as string, remoteNameDisplayable as string, requestedRoutings as string[], routingRing as boolean, segments as (conference as boolean, disconnectType as string, errorCode as string, q850ResponseCodes as integer[], queueId as string, requestedLanguageId as string, requestedRoutingSkillIds as string[], segmentEnd as string, segmentStart as string, segmentType as string, sipResponseCodes as integer[], subject as string, wrapUpCode as string)[], selectedAgentId as string, sessionDnis as string, sessionId as string, usedRouting as string)[], userId as string)[])[],",
				"          totalHits as integer",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'json',",
				"     fileSystem: 'raw',",
				"     documentForm: 'documentPerLine',",
				"     backslashEscape: true,",
				"     wildcardPaths:[(concat($FolderName,concat($FileName,'*.json')))]) ~> JsonSource",
				"JsonSource foldDown(unroll(conversations, conversations),",
				"     mapColumn(",
				"          conversationId = conversations.conversationId,",
				"          conversationStart = conversations.conversationStart,",
				"          conversationEnd = conversations.conversationEnd,",
				"          divisionIds = conversations.divisionIds,",
				"          originatingDirection = conversations.originatingDirection,",
				"          participants = conversations.participants",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"flatten6 sort(asc(conversationId, false),",
				"     asc(conversationStart, false),",
				"     asc(conversationEnd, false),",
				"     asc(divisionIds, false),",
				"     asc(originatingDirection, false),",
				"     asc(participantId, false),",
				"     asc(participantName, false)) ~> sort1",
				"flatten1 foldDown(unroll(divisionIds, divisionIds),",
				"     mapColumn(",
				"          conversationId,",
				"          conversationStart,",
				"          conversationEnd,",
				"          divisionIds,",
				"          originatingDirection,",
				"          participants",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten2",
				"flatten2 foldDown(unroll(participants, participants),",
				"     mapColumn(",
				"          conversationId,",
				"          conversationStart,",
				"          conversationEnd,",
				"          divisionIds,",
				"          originatingDirection,",
				"          participantId = participants.participantId,",
				"          participantName = participants.participantName,",
				"          purpose = participants.purpose,",
				"          userId = participants.userId,",
				"          sessions = participants.sessions",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten3",
				"flatten3 foldDown(unroll(sessions, sessions),",
				"     mapColumn(",
				"          conversationId,",
				"          conversationStart,",
				"          conversationEnd,",
				"          divisionIds,",
				"          originatingDirection,",
				"          participantId,",
				"          participantName,",
				"          purpose,",
				"          userId,",
				"          direction = sessions.direction,",
				"          mediaType = sessions.mediaType,",
				"          provider = sessions.provider,",
				"          sessionId = sessions.sessionId,",
				"          dnis = sessions.dnis,",
				"          entryType = sessions.flow.entryType,",
				"          entryReason = sessions.flow.entryReason,",
				"          flowId = sessions.flow.flowId,",
				"          flowName = sessions.flow.flowName,",
				"          flowType = sessions.flow.flowType,",
				"          startingLanguage = sessions.flow.startingLanguage,",
				"          endingLanguage = sessions.flow.endingLanguage,",
				"          exitReason = sessions.flow.exitReason,",
				"          selectedAgentId = sessions.selectedAgentId,",
				"          transferTargetAddress = sessions.flow.transferTargetAddress,",
				"          transferTargetName = sessions.flow.transferTargetName,",
				"          transferType = sessions.flow.transferType,",
				"          flowInType = sessions.flowInType,",
				"          remoteNameDisplayable = sessions.remoteNameDisplayable,",
				"          addressTo = sessions.addressTo,",
				"          metrics = sessions.metrics,",
				"          segments = sessions.segments",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten4",
				"flatten4 foldDown(unroll(metrics, metrics),",
				"     mapColumn(",
				"          conversationId,",
				"          conversationStart,",
				"          conversationEnd,",
				"          divisionIds,",
				"          originatingDirection,",
				"          participantId,",
				"          participantName,",
				"          purpose,",
				"          userId,",
				"          direction,",
				"          mediaType,",
				"          provider,",
				"          sessionId,",
				"          dnis,",
				"          entryType,",
				"          entryReason,",
				"          flowId,",
				"          flowName,",
				"          flowType,",
				"          startingLanguage,",
				"          endingLanguage,",
				"          exitReason,",
				"          selectedAgentId,",
				"          transferTargetAddress,",
				"          transferTargetName,",
				"          transferType,",
				"          flowInType,",
				"          remoteNameDisplayable,",
				"          addressTo,",
				"          name = metrics.name,",
				"          value = metrics.value,",
				"          segments",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten5",
				"flatten5 foldDown(unroll(segments, segments),",
				"     mapColumn(",
				"          conversationId,",
				"          conversationStart,",
				"          conversationEnd,",
				"          divisionIds,",
				"          originatingDirection,",
				"          participantId,",
				"          participantName,",
				"          purpose,",
				"          userId,",
				"          direction,",
				"          mediaType,",
				"          provider,",
				"          sessionId,",
				"          dnis,",
				"          entryType,",
				"          entryReason,",
				"          flowId,",
				"          flowName,",
				"          flowType,",
				"          startingLanguage,",
				"          endingLanguage,",
				"          exitReason,",
				"          selectedAgentId,",
				"          transferTargetAddress,",
				"          transferTargetName,",
				"          transferType,",
				"          flowInType,",
				"          remoteNameDisplayable,",
				"          addressTo,",
				"          name,",
				"          value,",
				"          conference = segments.conference,",
				"          queueId = segments.queueId,",
				"          segmentStart = segments.segmentStart,",
				"          segmentType = segments.segmentType,",
				"          segmentEnd = segments.segmentEnd,",
				"          disconnectType = segments.disconnectType,",
				"          subject = segments.subject",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten6",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     partitionFileNames:[(concat($FileName,'.parquet'))],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     saveOrder: 1,",
				"     mapColumn(",
				"          conversationId,",
				"          conversationStart,",
				"          conversationEnd,",
				"          divisionIds,",
				"          originatingDirection,",
				"          participantId,",
				"          participantName,",
				"          purpose,",
				"          userId,",
				"          direction,",
				"          mediaType,",
				"          provider,",
				"          sessionId,",
				"          dnis,",
				"          entryType,",
				"          entryReason,",
				"          flowId,",
				"          flowName,",
				"          flowType,",
				"          startingLanguage,",
				"          endingLanguage,",
				"          exitReason,",
				"          selectedAgentId,",
				"          transferTargetAddress,",
				"          transferTargetName,",
				"          transferType,",
				"          flowInType,",
				"          remoteNameDisplayable,",
				"          addressTo,",
				"          name,",
				"          value,",
				"          conference,",
				"          queueId,",
				"          segmentStart,",
				"          segmentType,",
				"          segmentEnd,",
				"          disconnectType,",
				"          subject",
				"     ),",
				"     partitionBy('hash', 1)) ~> ParquetDestination"
			]
		}
	}
}