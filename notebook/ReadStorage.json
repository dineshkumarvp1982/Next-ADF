				"source": [
					"%%pyspark\r\n",
					"df = spark.read.load('abfss://users@dscontosolake.dfs.core.windows.net/NYCTripSmall.parquet', format='parquet')\r\n",
					"display(df.limit(10))\r\n",
					"\r\n",
					""
				],
